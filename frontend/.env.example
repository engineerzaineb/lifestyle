# Modèle du fichier frontend/.env — copier en « .env » puis remplir.
# Ces valeurs sont publiques (elles arrivent dans le navigateur) : n'y mettez JAMAIS de clé secrète.

# Adresse de l'API du backend
VITE_API_URL=http://localhost:8000/api

# Connexion Google : même identifiant client que GOOGLE_CLIENT_ID du backend
VITE_GOOGLE_CLIENT_ID=

# Connexion Facebook : même identifiant que FACEBOOK_APP_ID du backend (jamais la clé secrète)
VITE_FACEBOOK_APP_ID=
# VITE_FACEBOOK_API_VERSION=v22.0

# Démonstration en ligne (tunnel ngrok) : adresse publique du frontend
# VITE_ALLOWED_HOSTS=yyyy.ngrok-free.app
