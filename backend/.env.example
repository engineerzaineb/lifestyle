# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais envoyer le fichier .env sur GitHub.

# Django
SECRET_KEY=
DEBUG=True

# Base de données PostgreSQL
DB_NAME=eventu
DB_USER=eventu_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Adresse du frontend (liens dans les e-mails)
FRONTEND_URL=http://localhost:5173

# E-mails : par défaut ils s'affichent dans le terminal.
# Pour un vrai envoi via Gmail, décommenter et remplir :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Eventu <noreply@eventu.tn>