# Modèle du fichier backend/.env — copier en « .env » puis remplir.
# Le vrai fichier .env n'est JAMAIS envoyé sur GitHub (il contient des secrets).

# ===== Django =====
SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Démonstration en ligne (tunnel ngrok) : décommenter et adapter
# ALLOWED_HOSTS=localhost,127.0.0.1,xxxx.ngrok-free.app
# DERRIERE_PROXY=True
# CORS_ORIGINES_SUPPLEMENTAIRES=https://yyyy.ngrok-free.app

# ===== Base de données PostgreSQL =====
DB_NAME=eventu
DB_USER=eventu_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ===== Adresse du frontend =====
# Sert aux liens envoyés par e-mail, au retour après paiement et aux QR codes des billets
FRONTEND_URL=http://localhost:5173

# ===== Connexion Google (Google Cloud Console > Identifiants) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Connexion Facebook (Meta for Developers > Paramètres > Général) =====
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===== Paiement Stripe (mode test) =====
# Clé secrète : tableau de bord Stripe > Développeurs > Clés API (commence par sk_test_)
STRIPE_SECRET_KEY=
# Clé du webhook : affichée par « stripe listen » (commence par whsec_)
STRIPE_WEBHOOK_SECRET=
STRIPE_DEVISE=tnd
# Seulement si le compte Stripe refuse le dinar : STRIPE_DEVISE=eur et le taux DT -> EUR
# STRIPE_TAUX_CONVERSION=0.30
# Temps laissé pour payer, en minutes (entre 31 et 1440) : les places restent bloquées
PAIEMENT_DELAI_MINUTES=35
# Le participant qui annule une réservation payée est remboursé automatiquement
REMBOURSEMENT_AUTORISE=True

# ===== E-mails (réinitialisation du mot de passe) =====
# Développement : les e-mails s'affichent dans le terminal du backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Envoi réel, par exemple avec Gmail et un mot de passe d'application :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=adresse.dediee@gmail.com
# EMAIL_HOST_PASSWORD=mot-de-passe-d-application
# DEFAULT_FROM_EMAIL=Eventu <adresse.dediee@gmail.com>
